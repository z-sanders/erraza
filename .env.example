# NOWPayments credentials
# Set to the NOWPayments dashboard-default payout ticker; use another ticker only if a separate provider contract confirms it.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAYOUT_CURRENCY=
# Required: exactly true for sandbox or false for live.
NOWPAYMENTS_SANDBOX=false

# Session and signing secrets (generate CHECKOUT_SECRET with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))")
CHECKOUT_SECRET=
# Optional; leave blank to disable the operator reconciliation endpoint.
RECONCILIATION_SECRET=

# Public origin (HTTPS required for IPN webhooks)
PUBLIC_BASE_URL=http://localhost:3000

# Supabase runtime credentials (server only; never expose the service-role key to browsers)
# Apply supabase-migration.sql before deploying code that uses these values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Merchant configuration
BRAND_NAME=Erraza
SUPPORT_EMAIL=
MIN_PAYMENT_AMOUNT=1
MAX_PAYMENT_AMOUNT=100000

# Fiat on-ramp (card payments via NOWPayments)
NOWPAYMENTS_FIAT_ENABLED=true
NOWPAYMENTS_FIAT_REDIRECT_HOSTS=

# Local server
PORT=3000
