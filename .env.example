# Backend-only configuration. Copy to .env for local use; never publish it.
# Missing required configuration disables payments. There is no demo/simulator.
# Put production values in Vercel Environment Variables, not public/ or source.

# Required: obtain matching API/IPN credentials from the NOWPayments dashboard.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Required: a unique random signing secret of at least 32 characters.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Do not reuse the provider API key. Keep separate secrets for preview/production.
CHECKOUT_SECRET=

# Optional: separate random operator-only secret (at least 32 characters).
# Enables POST /api/reconcile for manual merchant reconciliation. Never send this
# to the browser. Leave blank to disable that endpoint; no scheduled job is set up.
RECONCILIATION_SECRET=

# Required: exact public origin (no path/query/fragment). HTTPS in production.
# For local-only UI use http://localhost:3000. Real IPNs need a reachable HTTPS
# tunnel origin; use that same origin in your browser so session checks match.
PUBLIC_BASE_URL=http://localhost:3000

# Required: a dedicated persistent Upstash Redis database, not an in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV-compatible aliases may be used instead of the pair above:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Required: the exact primary payout/balance currency ticker in your dashboard.
# Used as currency_to when checking minimums. There is no guessed default.
NOWPAYMENTS_PAYOUT_CURRENCY=

# Choose exactly true or false. true uses a separate provider sandbox account;
# this is not an app simulation. Set false with live credentials for production.
NOWPAYMENTS_SANDBOX=false

# Provisional working name only; not domain/name/trademark cleared.
BRAND_NAME=Erraza
# Optional: real merchant support address. Blank hides it; do not invent one.
SUPPORT_EMAIL=
# Merchant bounds in the selected pricing currency, NOT an FX-normalized limit.
# Provider/network minimums can be higher. Use decimal strings, no exponents.
MIN_PAYMENT_AMOUNT=1
MAX_PAYMENT_AMOUNT=100000

# Fiat on-ramp is already activated for this merchant and is enabled here.
# Supported pricing fiat: USD, EUR, ILS, GBP, AUD, RON.
# Checkout uses the HTTPS provider link returned by NOWPayments.
# Optional additional restriction: exact comma-separated provider hostnames.
# Leave the host list empty for the normal provider-returned checkout flow.
NOWPAYMENTS_FIAT_ENABLED=true
NOWPAYMENTS_FIAT_REDIRECT_HOSTS=

# Local adapter always binds IPv4 loopback (127.0.0.1), never all interfaces.
PORT=3000
